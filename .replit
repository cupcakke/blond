entrypoint = "main.zig"
modules = ["zig-0.11"]

[nix]
channel = "stable-25_05"
packages = ["glibcLocales"]

[unitTest]
language = "zig"

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[deployment]
run = ["zig", "run", "main.zig"]
deploymentTarget = "cloudrun"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "zig run main.zig"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
